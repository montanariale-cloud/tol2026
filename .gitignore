# Progetti: il materiale (foto, csv di lavorazione, brief...) resta solo
# locale. Restano tracciati solo i file guida (README.md) di ogni progetto,
# cosi' la struttura e' visibile anche a chi clona la repo senza il materiale.
progetti/**
!progetti/**/
!progetti/**/README.md

# file di sistema / cache
.DS_Store
__pycache__/
*.pyc

# cartelle locali di lavoro (Claude Code, Codex, output di sessione) e
# bozze email: niente di tutto questo riguarda i siti pubblicati.
.claude/
.codex/
Claude outputs/
email/
